# Server-side only. Enable Routes API in your Google Cloud project.
GOOGLE_MAPS_API_KEY=
# Public HTTPS origin for browser requests behind a deployment proxy.
APP_ORIGIN=
# Select darwin, huxley or rtt. No automatic provider switching.
RAIL_PROVIDER=darwin
# Credentials for National Rail LDBWS JSON (not the SOAP token).
NATIONAL_RAIL_USERNAME=
NATIONAL_RAIL_PASSWORD=
# Huxley 2 public API: token optional ONLY if configured by your trusted host.
HUXLEY_BASE_URL=https://huxley2.azurewebsites.net
HUXLEY_ACCESS_TOKEN=
# RTT Next Generation API. Set ONE token type from https://api-portal.rtt.io.
RTT_ACCESS_TOKEN=
RTT_REFRESH_TOKEN=
# Optional: protect the planning endpoint of your personal deployment.
# Enter the same value in the app's Settings. Stored only in sessionStorage.
JOURNEY_ACCESS_TOKEN=
